# Opcional en local: npm start funciona sin crear un archivo .env.
# Estos valores son solo para el panel enlazado a loopback.
COBRIX_PANEL_USER=operador
COBRIX_PANEL_PASSWORD=cobrix-local-demo-2026

# Para personalizar el cifrado, define una clave estable de 64 caracteres hexadecimales.
# Si se omite, el proyecto genera data/cobrix.secret con permisos privados.
# COBRIX_SECRET_KEY=

# Para exponer el panel, además configura una clave propia y el proxy HTTPS.
# HOST=0.0.0.0
# COBRIX_SECURE_COOKIES=1
# COBRIX_API_HOSTS=isp.example.com
